{
  "manifest_version": 3,
  "name": "Diet-Youtube",
  "short_name": "Diet-Youtube",
  "version": "1.2.0",
  "description": "Replace YouTube’s impulse Home with a queue-first reading surface. Watch later first; the algorithm stays one click away.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Diet-Youtube",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://youtube.com/*"],
      "exclude_matches": [
        "https://www.youtube.com/embed/*",
        "https://youtube.com/embed/*",
        "https://www.youtube.com/live_chat*",
        "https://music.youtube.com/*"
      ],
      "js": ["src/content/boot.js"],
      "css": ["src/content/cloak.css"],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": ["https://www.youtube.com/*", "https://youtube.com/*"],
      "exclude_matches": [
        "https://www.youtube.com/embed/*",
        "https://youtube.com/embed/*",
        "https://www.youtube.com/live_chat*",
        "https://music.youtube.com/*"
      ],
      "js": ["src/content/content.bundle.js"],
      "css": ["src/ui/shell.css"],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": ["https://www.youtube.com/*", "https://youtube.com/*"],
      "exclude_matches": [
        "https://www.youtube.com/embed/*",
        "https://youtube.com/embed/*",
        "https://www.youtube.com/live_chat*",
        "https://music.youtube.com/*"
      ],
      "js": ["src/page/main-world.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
